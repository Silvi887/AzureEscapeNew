<div class="text-center">
	<h1 class="display-4">Holidays</h1>
@* 		<p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
 *@	<hr />
	<div class="container">

		<div class="row g-4">
			@*  row4 *@
			@foreach (var villa in Model.Items)
			{
				<div class="col-lg-4 col-md-6">
					<div class="villa-card shadow-sm">

						<div class="villa-image">
							<img src="@villa.ImageUrl" alt="@villa.NameVilla" style="height:200px;object-fit:cover;" />
							<span class="rating-badge">⭐ @villa.Raiting</span>
						</div>
						
						<div class="villa-body">
							<h4 class="villa-title">@villa.NameVilla</h4>

							<span class="place-badge">@villa.NamePlace</span>

							<div class="villa-info">
								<div><label asp-for="@villa.Pricepernight">💶 Price Per Night: </label> @villa.Pricepernight €</div>
								<div><strong>📍 Address:</strong> @villa.VillaAddress</div>
								<div><strong>👨 Adults:</strong> @villa.CountAdults</div>
								<div><strong>👶 Children:</strong> @villa.CountChildren</div>
								<div><strong>🌍 Location:</strong> @villa.LocationName</div>
							</div>

							<div class="villa-buttons">

								<a asp-area="Admin" asp-controller="Vila"
									asp-action="Details"
									asp-route-id="@villa.IdVilla" 
									class="btn btn-outline-primary">
										<i class="fa fa-info-circle"></i> Details
									</a>
								

								@if (User?.Identity?.IsAuthenticated == true &&  User.IsInRole("User"))
								{
									@* <a asp-controller="Reserve"
									   asp-action="AddBooking"
									   asp-route-id="@($"{villa.IdVilla},{villa.NameVilla},{villa.Pricepernight}")"
									   class="btn btn-primary">
										<i class="fa fa-calendar-check-o"></i> Reserve
									</a> *@
									<button class="btn btn-primary reserveBtn"
											data-id="@villa.IdVilla"
											data-name="@villa.NameVilla"
											data-price="@villa.Pricepernight"
											data-bcountadults="@villa.CountAdults"
											data-bcountchildren="@villa.CountChildren">
										<i class="fa fa-calendar-check-o"></i> Reserve
									</button>

									<form asp-controller="Favorite"
										  asp-action="GetFavorite"
										  asp-route-id="@villa.IdVilla"
										  method="post">

										<input type="hidden" name="id" value="@villa.IdVilla" />

										<button type="submit" class="btn btn-danger">
											<i class="fa fa-heart"></i>
										</button>
									</form>
								}

							</div>
						</div>

					</div>
				</div>
			
			}


		</div>
	
	</div>
	<div>
		@for (int i = 1; i <= Model.TotalPages; i++)
		{
			<a asp-action="Index" asp-route-page="@i"
			   class="btn @(i == Model.CurrentPage ? "btn-primary" : "btn-secondary")">
				@i
			</a>
		}
	</div>
</div>

<script>

	document.querySelectorAll(".reserveBtn").forEach(btn => {

		btn.addEventListener("click", async function () {
			   console.log("CLICK WORKS"); // test

			const villaId = this.dataset.id;

			console.log(villaId);
				if (!(villaId))
			{
				return BadRequest("id is missing");
			}
			const villaName = this.dataset.name;
			const price = this.dataset.price;

			const allidName=villaId +","+villaName;
			console.log(villaName);
			console.log(villaId);

			var adultscount=parseInt(this.dataset.bcountadults);
			var childrencount=parseInt(this.dataset.bcountchildren);

			  // ✅ Load partial view
			//     const response = await fetch(`/Reserve/AddBooking?id=${allidName}`);

			// 	if (!response.ok) {
			// 	console.error("API failed:", response.status);
			// 	return;
			// }
			// const html = await response.text();


			//console.log(html);
			Swal.fire({	/* sweet alert  */
				title: "Add Reservation",
				width: 800,
				html: `  <form id="popupForm" class="swal-form">

						  <input type="hidden" name="VillaId" id="idvilla" value="${villaId}">
						  <input type="hidden" name="pricepernight" id="price" value="${price}">
						  <input type="hidden" name="TotalPrice" id="totalPrice">
						  <!-- Guest Information -->
						  <fieldset class="form-section">
							<legend>Guest Information</legend>

							<div class="form-group">
							  <label for="firstName">First Name</label>
							  <input id="firstName" type="text" name="GuestFirstName">
							</div>

							<div class="form-group">
							  <label for="lastName">Last Name</label>
							  <input id="lastName" type="text" name="LastNameG">
							</div>

							<div class="form-group">
							  <label for="email">Email</label>
							  <input id="email" type="email" name="GuestEmail">
							</div>

							<div class="form-group">
							  <label for="phone">Phone Number</label>
							  <input id="phone" type="text" name="GuestPhoneNumber">
							</div>

							<div class="form-group">
							  <label for="datebirth">Date of Birth</label>
							  <input id="datebirth" type="date" name="DateofBirth">
							</div>

							<div class="form-group">
							  <label for="address">Address</label>
							  <input id="address" type="text" name="GuestAddress">
							</div>
						  </fieldset>

						  <!-- Reservation Details -->
						  <fieldset class="form-section">
							<legend>Reservation Details</legend>

							<div class="form-group">
							  <label for="start">Start Date</label>
							  <input id="start" type="text" name="StartDate">
							   <span id="date1Err" asp-validation-for="StartDate" class="text-danger"></span>
							</div>

							<div class="form-group">
							  <label for="end">End Date</label>
							  <input id="end" type="text" name="EndDate">
							</div>

							<div class="form-group">
							  <label for="adults">Adults Count</label>
							  <input id="adults" type="number" name="AdultsCount">
							</div>

							<div class="form-group">
							  <label for="children">Children Count</label>
							  <input id="children" type="number" name="ChildrenCount">
							</div>
						  </fieldset>

						  <!-- Summary -->
						  <div class="form-summary">
							<p class="villa-title"><strong>${villaName}</strong></p>
							<div id="totalBox" class="total-box"></div>
						  </div>

						</form>`,
						
	
				showCancelButton: true,
				confirmButtonText: "Book",
				didOpen: async () => {

					 const villaId = document.getElementById("idvilla").value;

					 if(!villaId){

					 console.log("element not found");
					 return;
					 }


					const response = await fetch(`/ReservationApi/GetAllDates?idvilla=${villaId}`);
					const reservedRanges = await response.json();


					  const disabledDates = reservedRanges.map(r => ({
					  from: flatpickr.parseDate(r.startDate, "Y-m-d"),
					  to: flatpickr.parseDate(r.endDate, "Y-m-d")
					}));

					const startEl = document.querySelector("#start");
					const endEl = document.querySelector("#end");

					if (startEl._flatpickr) startEl._flatpickr.destroy();
					if (endEl._flatpickr) endEl._flatpickr.destroy();


					  window.startPicker = flatpickr("#start", {
						minDate: "today",
						disable: disabledDates
					});

					 window.endPicker = flatpickr("#end", {
						minDate: "today",
						disable: disabledDates
					});
					//availabledates

					const start = document.getElementById("start");
					const end = document.getElementById("end");
					const totalBox = document.getElementById("totalBox");
					const totalprice= document.getElementById("totalPrice");
					function calculate() {
						if (!start.value || !end.value) return;

						let s = new Date(start.value);
						let e = new Date(end.value);


						console.log(s);
						console.log(e);
						let nights = (e - s) / (1000 * 60 * 60 * 24);

						if (nights > 0) {
							let total = nights * price;
							totalBox.innerHTML = `Nights: ${nights} | Total: €${total}`;
							totalprice.value=total;
						} else {
							totalBox.innerHTML = "";
						}
					}

					start.addEventListener("change", calculate);
					end.addEventListener("change", calculate);
				},
				preConfirm: async () => { /*validations for input fields */

				let errors = [];

				const start = document.getElementById("start").value;
				const end = document.getElementById("end").value;
				const adults = parseInt(document.getElementById("adults").value);
				const children =parseInt(document.getElementById("children").value);
				const firstName = document.getElementById("firstName").value;
				const txtlastName=document.getElementById("lastName").value;
				const txtphone=document.getElementById("phone").value;
				const txtdateofbirth=document.getElementById("datebirth").value;


				if (!firstName) errors.push("Please fill First Name!");
				if (!start) errors.push("Please fill Start Date!");
				if (!end) errors.push("Please fill End Date!");
				if(!txtlastName) errors.push("Please fillLastName is Required!");
				if(!txtphone)errors.push("Please fill Number is required!");
				if(!txtdateofbirth)errors.push("Please fill dateofbirth!");

				const today= new Date();

				 const dbirth = new Date(txtdateofbirth);
				 if(dbirth.getFullYear()<1940 || dbirth.getFullYear()> today.getFullYear()){
					 errors.push("Date of Birth must be valid date!")
				 }

				 if(dbirth.getMonth()<1 || dbirth.getMonth()>12){
					  errors.push("Month of Birth must be valid number!")
				 }

				  if(dbirth.getDay()<1 || dbirth.getDay()>31){
						errors.push("Day of Birth must be valid number!")
				 }

				 // console.log(dbirth.getFullYear());
				 // console.log(dbirth.getMonth());
				 // console.log(dbirth.getDate());

				if (start && end) {
					let s = new Date(start);
					let e = new Date(end);
					if (e <= s) errors.push("End Date must be after Start Date");
				}

				if (!adults || adults <= 0) {
					errors.push("Count of Adults must be greater than 0");
				}
				else if(adults > adultscount)
				{
				errors.push("Adults must be equal or less than the count in villa!");
				}

				if(children > childrencount)
				{
				errors.push("Children must be equal or less than the count in villa!");
				}

				if (errors.length > 0) {
					Swal.showValidationMessage(errors.join("<br>"));
					return false;
				}
				 // ✅ SEND DATA WITH AJAX
				const form = document.getElementById("popupForm");
				const formData = new FormData(form);

				try {
				const response = await fetch('/Reserve/Add', {
					method: 'POST',
					body: formData
				});

	
				if (!response.ok) {
					throw new Error();
				}

				return true;

				} catch (error) {
					Swal.showValidationMessage("Server error");
					return false;
				}
	
				}
				}).then((result) => {
				if (result.isConfirmed) {
					Swal.fire({
						icon: 'success',
						title: 'Successful reservation!',
						confirmButtonColor: '#28a745'
					}).then(() => {
						location.reload();
					});
				}
			});
	

		

	 	});

	});
		

</script>
