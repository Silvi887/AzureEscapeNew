@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Oops!";
  
}

@model ErrorViewModel


<div class="error-page d-flex align-items-center justify-content-center">
    <div class="text-center">

        <div class="error-code">500</div>

        <h2 class="mb-3">Oops! Page not found</h2>
        <h1 class="display-4 text-danger">Internal Server Error 500.</h1>
        <p class="text-muted mb-4">
            The page you’re looking for doesn’t exist or has been moved.
        </p>

        <a asp-controller="Vila"
           asp-action="Index"
           class="btn btn-primary px-4 py-2">
            <i class="fas fa-home"></i> Back to Home
        </a>

    </div>
</div>

<style>
    html.body{
        background: linear-gradient(135deg, #d4f8e8, #b7efd4);
    }

    header {
        margin: 0px;
        padding: 0px;
    }

    .container_main {
        height: 100vh;
        margin: 0px;
        padding: 0px;
    }
    .error-page {
       min-height: 100vh;
        background: linear-gradient(135deg, #d4f8e8, #b7efd4); /*  #d4f8e8, #b7efd4 */
        color: white;
    }

    .error-code {
        font-size: 120px;
        font-weight: 800;
        letter-spacing: 5px;
        background: linear-gradient(45deg, #ff6b6b, #f06595);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    h2 {
        font-weight: 600;
    }

    .btn-primary {
        border-radius: 30px;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-primary:hover {
            transform: scale(1.05);
        }
</style>
