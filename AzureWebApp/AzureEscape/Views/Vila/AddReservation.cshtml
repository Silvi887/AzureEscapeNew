@{

    ViewData["Title"] = "Add Reservation";
    var today = DateTime.Now.ToString("dd-MM-yyyy");
}



@using AzureApp.ViewModels

@model AddReservationViewModel



<h2 class="mb-4">Add a New Reservation</h2>


<div class="card shadow-sm" ng-app="reservationApp" ng-controller="reservationCtrl">
@* <div class="card shadow-sm"> *@
    <div class="card-body">
        <form asp-action="Add" method="post">
            <div class="row g-3">

                <div class="col-md-6 form-floating">
                    @* <input asp-for="@Model.VilaName" class="form-control" placeholder="@Model.VilaName" /> *@
                    <label asp-for="@Model.VilaName">@Model.VilaName</label>
                    <input asp-for="@Model.VillaId" type="hidden" aria-required="true" />
                    <input asp-for="@Model.pricepernight" type="hidden" aria-required="true" ng-init="pricePerNight=@Model.pricepernight" />
                </div>
                <div class="col-md-6 form-floating">
                    <input id="startDate" asp-for="@Model.StartDate" class="form-control" type="date" placeholder="Start Date" ng-model="startDate" />
                    <label asp-for="@Model.StartDate"></label>
                    @* <span id="date1Err" asp-validation-for="StartDate" ></span> *@
                    <span id="date1Err" asp-validation-for="StartDate" class="text-danger"></span> 
                </div>

                <div class="col-md-6 form-floating">
                    <input id="endDate" asp-for="@Model.EndDate" class="form-control" type="date" placeholder="End Date" ng-model="endDate" />
                    <label asp-for="@Model.EndDate"></label>
                   <span id="date2Err" asp-validation-for="@Model.EndDate" class="text-danger"></span> 
                    @* <span id="date2Err" asp-validation-for="@Model.EndDate"></span> *@
                </div>

                <div class="col-md-6 form-floating">
                    <input id="adultsCount" asp-for="@Model.AdultsCount" class="form-control" placeholder="Adults Count" />
                    <label asp-for="@Model.AdultsCount"></label>
                    <span id="erradultscount" asp-validation-for="@Model.AdultsCount" class="text-danger" ></span>
                </div>

                <div class="col-md-6 form-floating">
                    <input asp-for="@Model.ChildrenCount" class="form-control" placeholder="Children Count" />
                    <label asp-for="@Model.ChildrenCount"></label>
                    <span asp-validation-for="@Model.ChildrenCount" class="text-danger"></span>
                </div>

                <div class="col-md-6 form-floating">
                    <input asp-for="@Model.GuestFirstName" class="form-control" placeholder="First Name" />
                    <label asp-for="@Model.GuestFirstName">FirstName</label>
                    <span asp-validation-for="@Model.GuestFirstName" class="text-danger"></span>
                </div>

                <div class="col-md-6 form-floating">
                    <input asp-for="@Model.LastNameG" class="form-control" placeholder="Last Name" />
                    <label asp-for="@Model.LastNameG">Last Name</label>
                    <span asp-validation-for="@Model.LastNameG" class="text-danger"></span>
                </div>

                <div class="col-md-6 form-floating">
                    <input asp-for="@Model.DateofBirth" class="form-control" type="date" placeholder="Date of Birth" />
                    <label asp-for="@Model.DateofBirth">Date of Birth</label>
                    <span asp-validation-for="@Model.DateofBirth" class="text-danger"></span>
                </div>

                <div class="col-md-6 form-floating">
                    <input asp-for="@Model.GuestAddress" class="form-control" placeholder="Address" />
                    <label asp-for="@Model.GuestAddress">Address</label>
                    <span asp-validation-for="@Model.GuestAddress" class="text-danger"></span>
                </div>

                <div class="col-md-6 form-floating">
                    <input asp-for="@Model.GuestPhoneNumber" class="form-control" placeholder="Phone Number" />
                    <label asp-for="@Model.GuestPhoneNumber">Phone Number</label>
                    <span asp-validation-for="@Model.GuestPhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6 form-floating">
                    <input asp-for="@Model.GuestEmail" class="form-control" placeholder="Email" />
                    <label asp-for="@Model.GuestEmail">Email</label>
                    <span asp-validation-for="@Model.GuestEmail" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <h5>Total Nights: {{ nights }}</h5>
                    <h4>Total Price: {{ totalPrice() | currency:"€" }}</h4>
                </div>

            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">Submit Reservation</button>
                <a asp-controller="Vila" asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success">
                    @ViewBag.SuccessMessage
                </div>
            }
        </form>
    </div>
</div>


<script>

    var app = angular.module("reservationApp", []);

    app.controller("reservationCtrl", function ($scope) {

        $scope.pricePerNight = 0;

        $scope.totalPrice = function () {

            if (!$scope.startDate || !$scope.endDate)
                return 0;

            let start = new Date($scope.startDate);
            let end = new Date($scope.endDate);

            let diffTime = end - start;

            let nights = diffTime / (1000 * 60 * 60 * 24);

            if (nights < 0) nights = 0;

            $scope.nights = nights;

            return nights * $scope.pricePerNight;
        };

    });

</script>
