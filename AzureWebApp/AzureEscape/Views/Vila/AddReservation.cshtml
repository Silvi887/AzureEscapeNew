<script>

    var app = angular.module("reservationApp", []);

    app.controller("reservationCtrl", function ($scope) {

        $scope.pricePerNight = 0;

        $scope.totalPrice = function () {

            if (!$scope.startDate || !$scope.endDate)
                return 0;

            let start = new Date($scope.startDate);
            let end = new Date($scope.endDate);

            let diffTime = end - start;

            let nights = diffTime / (1000 * 60 * 60 * 24);

            if (nights < 0) nights = 0;

            $scope.nights = nights;

            return nights * $scope.pricePerNight;
        };

    });

</script> *@

