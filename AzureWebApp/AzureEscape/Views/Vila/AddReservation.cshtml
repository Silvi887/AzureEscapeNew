@{

    ViewData["Title"] = "Add Reservation";
    var today = DateTime.Now.ToString("dd-MM-yyyy");
}



@using AzureApp.ViewModels
@model AddReservationViewModel


<form id="popupForm" class="swal-form">

    <input type="hidden" name="VillaId" id="idvilla" value="${villaId}">
    <input type="hidden" name="pricepernight" id="price" value="${price}">
    <input type="hidden" name="TotalPrice" id="totalPrice">
    <!-- Guest Information -->
    <fieldset class="form-section">
        <legend>Guest Information</legend>

        <div class="form-group">
            <label for="firstName">First Name</label>
            <input id="firstName" type="text" name="GuestFirstName">
        </div>

        <div class="form-group">
            <label for="lastName">Last Name</label>
            <input id="lastName" type="text" name="LastNameG">
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input id="email" type="email" name="GuestEmail">
        </div>

        <div class="form-group">
            <label for="phone">Phone Number</label>
            <input id="phone" type="text" name="GuestPhoneNumber">
        </div>

        <div class="form-group">
            <label for="datebirth">Date of Birth</label>
            <input id="datebirth" type="date" name="DateofBirth">
        </div>

        <div class="form-group">
            <label for="address">Address</label>
            <input id="address" type="text" name="GuestAddress">
        </div>
    </fieldset>

    <!-- Reservation Details -->
    <fieldset class="form-section">
        <legend>Reservation Details</legend>

        <div class="form-group">
            <label for="start">Start Date</label>
            <input id="start" type="text" name="StartDate">
            <span id="date1Err" asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="end">End Date</label>
            <input id="end" type="text" name="EndDate">
        </div>

        <div class="form-group">
            <label for="adults">Adults Count</label>
            <input id="adults" type="number" name="AdultsCount">
        </div>

        <div class="form-group">
            <label for="children">Children Count</label>
            <input id="children" type="number" name="ChildrenCount">
        </div>
    </fieldset>

    <!-- Summary -->
    <div class="form-summary">
        <label class="villa-title" name="VilaName">Vila: @Model.VilaName</label>
        <div id="totalBox" class="total-box"></div>
    </div>

</form>

