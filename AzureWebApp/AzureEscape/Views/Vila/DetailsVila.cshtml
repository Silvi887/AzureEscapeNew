@using AzureApp.ViewModels;
@model DetailsIndexVilla


<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="row g-0">
            <div class="col-md-5">
                <img src="@Model.ImageUrl" class="img-fluid rounded-start" alt="Villa Image">
            </div>
            <div class="col-md-7">
                <div class="card-body">
                    <h2 class="card-title text-primary">@Model.VilaName</h2>
                    <p class="card-text"><strong>📍 Town:</strong> @Model.TownName</p>
                    <p class="card-text"><strong>🏷️ Type:</strong> @Model.TypePlace</p>
                    <p class="card-text"><strong>🚪 Rooms:</strong> @Model.NumberofRooms</p>
                    <p class="card-text"><strong>🛏️ Bedrooms:</strong> @Model.Bedrooms</p>
                    <p class="card-text"><strong>🛁 Bathrooms:</strong> @Model.Bathrooms</p>
                    <p class="card-text"><strong>👨‍👩‍👧 Adults:</strong> @Model.CountAdults</p>
                    <p class="card-text"><strong>🧒 Children:</strong> @Model.CountChildren</p>
                    <p class="card-text"><strong>🅿️ Parking:</strong> @Model.Parking</p>
                  @*   <p class="card-text"><strong>👤 Guest ID:</strong> @Model.GuestId</p>
                    <p class="card-text"><strong>🧑‍💼 Manager ID:</strong> @Model.ManagerId</p>
                    <p class="card-text"><strong>🛡️ Is Manager:</strong> @(Model.IsManager ? "Yes" : "No")</p>
                    <p class="card-text"><strong>💾 Saved:</strong> @(Model.IsSaved ? "Yes" : "No")</p>
 *@
                    <hr />
                    <h5 class="text-secondary">📄 Villa Info</h5>
                    <p class="card-text">@Model.VilaInfo</p>
                    <div class="mt-4 d-flex  align-items-center gap-4  flex-wrap">
                     @*  @if (User?.Identity?.IsAuthenticated == true && !Model.IsManager && !Model.IsSaved) *@

                        @if (this.User.Identity?.IsAuthenticated ?? false)
                        {
                            <form asp-controller="Favorite" asp-action="GetFavorite" asp-route-id="@Model.IdVila" method="post" class="d-flex justify-content-center align-items-center mx-1">
                                <input type="hidden" id="villaId" name="idvilla" value="@Model.IdVila" />
                                <button type="submit" class="btn btn-success">
                                    <i class="fa fa-heart"></i> Add to Favorites
                                </button>
                            </form>
                            @*  @if (User?.Identity?.IsAuthenticated == true && User?.Identity?.Name == "admin@horizons.com") *@
                            @*  @if (this.User.Identity?.IsAuthenticated ?? false)
                        { asp-action="EditVilla" asp-route-id="@Model.IdVila" asp-controller="Vila" *@  

                            <a data-id="@Model.IdVila"  class="btn btn-warning editVillaBtn ml-1">✏️ Edit</a>
                            <a asp-action="LeaveFeedback" asp-route-id="@Model.IdVila" asp-controller="FeedBack" class="btn btn-warning ml-1">✏️ Feddback</a>
                            <a asp-action="Index" class="btn btn-secondary ml-1">🔙 Back to List</a>

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var buttonEdit=document.querySelector(".editVillaBtn");
        buttonEdit.addEventListener("click", async function () {

            const villaId = this.dataset.id;

            // ✅ Load partial view
            const response = await fetch(`/VilaPartial/EditVillaPartial?id=${villaId}`);

            if (!response.ok) {
                Swal.fire("Error", "Cannot load form", "error");
                return;
            }

            const html = await response.text();

            console.log(html);
            Swal.fire({
                title: "Edit Villa",
                html: html,
                width: 700,
                showCancelButton: true,
                confirmButtonText: "Save",

                didOpen:async () => {
                    // Optional: re-init validation if needed
                },

                preConfirm: async () => {

                    const form = document.getElementById("editVillaForm");
                    const formData = new FormData(form);

                   

                    try {
                          const vId = this.dataset.id;
                        const res = await fetch('/VilaPartial/EditVilla', {
                            method: 'POST',
                            body: formData
                        });
                        console.log("Status:", res.status);

                            if (!res.ok) {
                const errorText = await res.text();
                Swal.showValidationMessage(errorText);
                return false;
                }

                        return true;

                    } catch {
                        Swal.showValidationMessage("Error saving changes");
                        return false;
                    }
                }

            }).then(result => {
                if (result.isConfirmed) {
                    Swal.fire("Success", "Villa updated!", "success")
                        .then(() => location.reload());
                }
            });

        });

    
</script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

