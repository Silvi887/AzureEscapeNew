</div>
<script>

	document.querySelectorAll(".reserveBtn").forEach(btn => {

		btn.addEventListener("click", function () {

			const villaId = this.dataset.id;
			const villaName = this.dataset.name;
			const price = this.dataset.price;

			Swal.fire({						/* sweet alert  */
				title: "Add Reservation",
				width: 800,
				html: `  <form id="popupForm" method="post"  action="/Reserve/Add" class="swal-form">

						  <input type="hidden" name="VillaId" value="${villaId}">
						  <input type="hidden" name="pricepernight" id="price" value="${price}">
						  <input type="hidden" name="TotalPrice" id="totalPrice">
						  <!-- Guest Information -->
						  <fieldset class="form-section">
							<legend>Guest Information</legend>

							<div class="form-group">
							  <label for="firstName">First Name</label>
							  <input id="firstName" type="text" name="GuestFirstName">
							</div>

							<div class="form-group">
							  <label for="lastName">Last Name</label>
							  <input id="lastName" type="text" name="LastNameG">
							</div>

							<div class="form-group">
							  <label for="email">Email</label>
							  <input id="email" type="email" name="GuestEmail">
							</div>

							<div class="form-group">
							  <label for="phone">Phone Number</label>
							  <input id="phone" type="text" name="GuestPhoneNumber">
							</div>

							<div class="form-group">
							  <label for="datebirth">Date of Birth</label>
							  <input id="datebirth" type="date" name="DateofBirth">
							</div>

							<div class="form-group">
							  <label for="address">Address</label>
							  <input id="address" type="text" name="GuestAddress">
							</div>
						  </fieldset>

						  <!-- Reservation Details -->
						  <fieldset class="form-section">
							<legend>Reservation Details</legend>

							<div class="form-group">
							  <label for="start">Start Date</label>
							  <input id="start" type="date" name="StartDate">
							   <span id="date1Err" asp-validation-for="StartDate" class="text-danger"></span>
							</div>

							<div class="form-group">
							  <label for="end">End Date</label>
							  <input id="end" type="date" name="EndDate">
							</div>

							<div class="form-group">
							  <label for="adults">Adults Count</label>
							  <input id="adults" type="number" name="AdultsCount">
							</div>

							<div class="form-group">
							  <label for="children">Children Count</label>
							  <input id="children" type="number" name="ChildrenCount">
							</div>
						  </fieldset>

						  <!-- Summary -->
						  <div class="form-summary">
							<p class="villa-title"><strong>${villaName}</strong></p>
							<div id="totalBox" class="total-box"></div>
						  </div>

						</form>`,
	
				showCancelButton: true,
				confirmButtonText: "Book",
				didOpen: () => {

					const start = document.getElementById("start");
					const end = document.getElementById("end");
					const totalBox = document.getElementById("totalBox");
					const totalprice= document.getElementById("totalPrice");
					function calculate() {
						if (!start.value || !end.value) return;

						let s = new Date(start.value);
						let e = new Date(end.value);

						let nights = (e - s) / (1000 * 60 * 60 * 24);

						if (nights > 0) {
							let total = nights * price;
							totalBox.innerHTML = `Nights: ${nights} | Total: €${total}`;
							totalprice.value=total;
						} else {
							totalBox.innerHTML = "";
						}
					}

					start.addEventListener("change", calculate);
					end.addEventListener("change", calculate);
				},
					preConfirm: async () => { /*validations for input fields */

		let errors = [];

		const start = document.getElementById("start").value;
		const end = document.getElementById("end").value;
		const adults = document.getElementById("adults").value;
		const firstName = document.getElementById("firstName").value;
		const txtlastName=document.getElementById("lastName").value;
		const txtphone=document.getElementById("phone").value;
		const txtdateofbirth=document.getElementById("datebirth").value;


		if (!firstName) errors.push("First Name is required");
		if (!start) errors.push("Start Date is required");
		if (!end) errors.push("End Date is required");
		if(!txtlastName) errors.push("LastName is Required!");
		if(!txtphone) errors.push("Phone Number is required!");
		if(!txtdateofbirth) errors.push("You have to fill dateofbirth!");

		if (start && end) {
			let s = new Date(start);
			let e = new Date(end);
			if (e <= s) errors.push("End Date must be after Start Date");
		}

		if (!adults || adults <= 0) {
			errors.push("Adults must be greater than 0");
		}

		if (errors.length > 0) {
			Swal.showValidationMessage(errors.join("<br>"));
			return false;
		}
		 // ✅ SEND DATA WITH AJAX
	    const form = document.getElementById("popupForm");
		const formData = new FormData(form);

	    try {
		const response = await fetch('/Reserve/Add', {
			method: 'POST',
			body: formData
		});

		// if (!response.ok) {
		// 	Swal.showValidationMessage("Error saving reservation");
		// 	return false;
		// }
		if (!response.ok) {
			throw new Error();
		}

		return true;

		} catch (error) {
			Swal.showValidationMessage("Server error");
			return false;
		}
	
		}
		}).then((result) => {
		if (result.isConfirmed) {
			Swal.fire({
				icon: 'success',
				title: 'Successful reservation!',
				confirmButtonColor: '#28a745'
			}).then(() => {
				location.reload();
			});
		}
	});
	

		

		});

	});

</script>
