@using AzureApp.ViewModels;
@model List<VilaIndexViewModel>

<div class="backimage">
	<!-- Search section-->

	<div class="search-overlay divsearch w-100">
		
		<div class="container">
			<form asp-controller="Vila" asp-action="SearchVilaByDate" method="get" class="row g-3 p-3 rounded shadow">
				<div class="col-md-4">
					<label for="startDate" class="form-label">Start Date</label>
					<input type="date" id="startDate" name="startDate" class="form-control" required />
				</div>
				<div class="col-md-4">
					<label for="endDate" class="form-label">End Date</label>
					<input type="date" id="endDate" name="endDate" class="form-control" required />
				</div>
				<div class="col-md-4 d-flex align-items-end">
					<button type="submit" class="btn btn-primary w-100" style="background-color:#637496; color:#fff">
						<i class="fa fa-search"></i> Search Villas
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="text-center">
	<h1 class="display-4">Holidays</h1>
@* 		<p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
 *@	<hr />
	<div class="container">

		<div class="row g-4">
			@*  row4 *@
			@foreach (var villa in Model)
			{
				<div class="col-lg-4 col-md-6">
					<div class="villa-card shadow-sm">

						<div class="villa-image">
							<img src="@villa.ImageUrl" alt="@villa.NameVilla" style="height:200px;object-fit:cover;" />
							<span class="rating-badge">⭐ @villa.Raiting</span>
						</div>
						
						<div class="villa-body">
							<h4 class="villa-title">@villa.NameVilla</h4>

							<span class="place-badge">@villa.NamePlace</span>

							<div class="villa-info">
								<div><label asp-for="@villa.Pricepernight">💶 Price Per Night: </label> @villa.Pricepernight €</div>
								<div><strong>📍 Address:</strong> @villa.VillaAddress</div>
								<div><strong>👨 Adults:</strong> @villa.CountAdults</div>
								<div><strong>👶 Children:</strong> @villa.CountChildren</div>
								<div><strong>🌍 Location:</strong> @villa.LocationName</div>
							</div>

							<div class="villa-buttons">

								<a asp-controller="Vila"
								   asp-action="Details"
								   asp-route-id="@villa.IdVilla"
								   class="btn btn-outline-primary">
									<i class="fa fa-info-circle"></i> Details
								</a>

								@if (User?.Identity?.IsAuthenticated == true && ViewBag.EmailConfirmed == false)
								{
									@* <a asp-controller="Reserve"
									   asp-action="AddBooking"
									   asp-route-id="@($"{villa.IdVilla},{villa.NameVilla},{villa.Pricepernight}")"
									   class="btn btn-primary">
										<i class="fa fa-calendar-check-o"></i> Reserve
									</a> *@
									<button class="btn btn-primary reserveBtn"
											data-id="@villa.IdVilla"
											data-name="@villa.NameVilla"
											data-price="@villa.Pricepernight">
										<i class="fa fa-calendar-check-o"></i> Reserve
									</button>

									<form asp-controller="Favorite"
										  asp-action="GetFavorite"
										  asp-route-id="@villa.IdVilla"
										  method="post">

										<input type="hidden" name="id" value="@villa.IdVilla" />

										<button type="submit" class="btn btn-danger">
											<i class="fa fa-heart"></i>
										</button>
									</form>
								}

							</div>
						</div>

					</div>
				</div>

				
				@* <div class="classItem">
					<h4> @villa.NameVilla </h4>
					<img src=@villa.ImageUrl alt="" />

					<div class="classraiting"> <div><span class="nameplace-btn"> @villa.NamePlace</span></div>&nbsp;&nbsp; &nbsp;&nbsp;  Rating: ⭐ @villa.Raiting</div>
				
					<ul>
						<li><span> Address: </span>@villa.VillaAddress </li>
						<li><span> Count Adults:</span>@villa.CountAdults</li>
						<li> <span> Count Children: @villa.CountChildren</span> </li>
						<li><span> Location Name: @villa.LocationName</span></li>
						
					</ul>

					<div class="classBtns">
						<a asp-controller="Vila" asp-action="Details" asp-route-id="@villa.IdVilla" class="btn btn-info">
							<i class="fa fa-info-circle"></i> More info
						</a>

						@if (User?.Identity?.IsAuthenticated == true && ViewBag.EmailConfirmed == false)
						{

							<a asp-controller="Reserve" asp-action="AddBooking" asp-route-id="@($"{villa.IdVilla},{villa.NameVilla}")" class="btn btn-info w-70">
								<i class="fa fa-calendar-check-o"></i> Make reservation
							</a>

							<form asp-controller="Favorite" asp-action="GetFavorite" asp-route-id="@villa.IdVilla" method="post" class="w-50">
								<input type="hidden" name="id" value="@villa.IdVilla" />
								<button type="submit" class="btn btn-success w-100">
									<i class="fa fa-heart"></i> Favorites
								</button>
							</form>
						}

					</div>
					

				</div> *@
			}


		</div>
	</div>
</div>
<script>

	document.querySelectorAll(".reserveBtn").forEach(btn => {

		btn.addEventListener("click", function () {

			const villaId = this.dataset.id;
			const villaName = this.dataset.name;
			const price = this.dataset.price;

			Swal.fire({
				title: "Add Reservation",
				width: 800,
				html: `
							<form id="popupForm" method="post" action="/Reserve/Add"class="swal-split-form">

		<input type="hidden" name="VillaId" value="${villaId}">
		<input type="hidden" name="pricepernight" id="price" value="${price}">

		<div class="split-container">

			<!-- LEFT COLUMN -->
			<div class="column">

				<div class="form-group">
					<label>Last Name</label>
					<input type="text" name="LastNameG">
				</div>

				<div class="form-group">
					<label>Children Count</label>
					<input type="number" name="ChildrenCount">
				</div>

				<div class="form-group">
					<label>Address</label>
					<input type="text" name="Address">
				</div>

				<div class="form-group">
					<label>Email</label>
					<input type="email" name="GuestEmail">
				</div>

			</div>

			<!-- RIGHT COLUMN -->
			<div class="column">

				<div class="form-group">
					<label>Start Date</label>
					<input type="date" id="start" name="StartDate">
				</div>

				<div class="form-group">
					<label>End Date</label>
					<input type="date" id="end" name="EndDate">
				</div>

				<div class="form-group">
					<label>Adults Count</label>
					<input type="number" name="AdultsCount">
				</div>

				<div class="form-group">
					<label>First Name</label>
					<input type="text" name="GuestFirstName">
				</div>

				<div class="form-group">
					<label>Date of Birth</label>
					<input type="date" name="DateOfBirth">
				</div>

				<div class="form-group">
					<label>Phone Number</label>
					<input type="text" name="PhoneNumber">
				</div>

			</div>

		</div>

		<p class="villa-title"><strong>${villaName}</strong></p>

		<div id="totalBox" class="total-box"></div>

	</form>

				`,
				showCancelButton: true,
				confirmButtonText: "Book",
				didOpen: () => {

					const start = document.getElementById("start");
					const end = document.getElementById("end");
					const totalBox = document.getElementById("totalBox");

					function calculate() {
						if (!start.value || !end.value) return;

						let s = new Date(start.value);
						let e = new Date(end.value);

						let nights = (e - s) / (1000 * 60 * 60 * 24);

						if (nights > 0) {
							let total = nights * price;
							totalBox.innerHTML = `Nights: ${nights} | Total: €${total}`;
						} else {
							totalBox.innerHTML = "";
						}
					}

					start.addEventListener("change", calculate);
					end.addEventListener("change", calculate);
				},
				preConfirm: () => {
					document.getElementById("popupForm").submit();
				}
			});

		});

	});

</script>

