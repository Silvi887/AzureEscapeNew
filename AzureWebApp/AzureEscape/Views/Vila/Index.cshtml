			@*  row4 *@
			@foreach (var villa in Model)
			{
				<div class="col-lg-4 col-md-6">
					<div class="villa-card shadow-sm">

						<div class="villa-image">
							<img src="@villa.ImageUrl" alt="@villa.NameVilla" style="height:200px;object-fit:cover;" />
							<span class="rating-badge">⭐ @villa.Raiting</span>
						</div>
						
						<div class="villa-body">
							<h4 class="villa-title">@villa.NameVilla</h4>

							<span class="place-badge">@villa.NamePlace</span>

							<div class="villa-info">
								<div><label asp-for="@villa.Pricepernight">💶 Price Per Night: </label> @villa.Pricepernight €</div>
								<div><strong>📍 Address:</strong> @villa.VillaAddress</div>
								<div><strong>👨 Adults:</strong> @villa.CountAdults</div>
								<div><strong>👶 Children:</strong> @villa.CountChildren</div>
								<div><strong>🌍 Location:</strong> @villa.LocationName</div>
							</div>

							<div class="villa-buttons">

								<a asp-controller="Vila"
								   asp-action="Details"
								   asp-route-id="@villa.IdVilla"
